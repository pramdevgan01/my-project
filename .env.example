# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite+aiosqlite:///./femas.db
EVIDENCE_STORAGE_DIR=./evidence_store
# Any OpenRouter model id works; ":free" models cost nothing (rate-limited).
# Pick one that supports tool calling, e.g.:
#   meta-llama/llama-3.3-70b-instruct:free
#   deepseek/deepseek-chat-v3.1:free
AGENTS_MODEL=meta-llama/llama-3.3-70b-instruct:free
