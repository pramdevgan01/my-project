{
  "rules": [
    {
      "condition": "always",
      "commandType": "vscode",
      "command": "studio-manager.openFile main.py 1"
    },
    {
      "condition": "always",
      "commandType": "vscode",
      "command": "studio-manager.openSimpleBrowser https://${STUDIO_HOST_ID}-8000.${STUDIO_HOST}",
      "delay": 2000
    },
    {
      "condition": "always",
      "commandType": "vscode",
      "command": "studio-manager.openTerminal",
      "cmdArgs": [
        "fastapi dev main.py --host 0.0.0.0 --port 8000",
        {
          "name": "fastapi",
          "location": 1
        }
      ],
      "delay": 500
    }
  ],
  "simpleBrowserDefaultAppUrl": "https://${STUDIO_HOST_ID}-8000.${STUDIO_HOST}"
}
